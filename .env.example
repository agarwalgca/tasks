# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only the anon (publishable) key belongs here. Never put the service_role key
# in this file or anywhere in the client.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public half of the VAPID pair used for reminder push notifications.
# Generate with: npx web-push generate-vapid-keys
# The private half goes to the Edge Function, never here.
VITE_VAPID_PUBLIC_KEY=
